cff-version: 1.2.0
message: "If you use this package, please cite both the original publication (Schweke et al. 2023) and this OpenEBench implementation."
title: "ELIXIR - Protein-Protein Interface Benchmark - OpenEBench Experiment"
abstract: >-
  OpenEBench implementation of the ELIXIR 3D-BioInfo benchmark for discriminating physiological from crystallographic protein homodimer
  interfaces: schema-validated OpenEBench metadata, the datasets of 14 reference scoring methods, four homology-aware cross-validation
  fold assignments, the workflow scripts and a static page that evaluates new predictions in the browser. 1,671 entries (840 physiological
  and 831 non-physiological), from the curated annotation of the benchmark authors without the six entries flagged for deletion.
type: dataset
authors:
  - family-names: "Capriotti"
    given-names: "Emidio"
    orcid: "https://orcid.org/0000-0002-2323-0963"
    affiliation: "University of Bologna"
  - family-names: "Martelli"
    given-names: "Pier Luigi"
    orcid: "https://orcid.org/0000-0002-0274-5669"
    affiliation: "University of Bologna"
  - family-names: "Savojardo"
    given-names: "Castrense"
    orcid: "https://orcid.org/0000-0002-7359-0633"
    affiliation: "University of Bologna"
version: "1.0.0"
license: CC-BY-NC-4.0
repository-code: "https://github.com/elixir-unibo/oeb_3dbioinfo_ppi_benchmark"
url: "https://elixir.unibo.it/tools/oeb_3dbioinfo_ppi_benchmark/"
keywords:
  - "protein-protein interface"
  - "structural bioinformatics"
  - "benchmark dataset"
  - "OpenEBench"
  - "homodimer interfaces"
  - "scoring functions"

